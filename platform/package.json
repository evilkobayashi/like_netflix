{
  "name": "enterprise-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "dev": "npm run -ws dev",
    "test": "npm run -ws test",
    "lint": "npm run build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/http-proxy": "^10.0.1",
    "@fastify/sensible": "^6.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.5",
    "bcrypt": "^5.1.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "nats": "^2.28.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.4.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "type": "module"
}
